# Brewluxe Environment Configuration
# Copy this file to .env and fill in your project credentials.

# Supabase Database & Auth (Required)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# PayMongo Payment Gateway (Test Mode / Sandbox)
PAYMONGO_PUBLIC_KEY=pk_test_your_key_here
PAYMONGO_SECRET_KEY=sk_test_your_key_here

# Email receipts must be sent from a trusted server endpoint. Never add a Resend
# API key to a client-side Angular environment or browser bundle.

# Cloudinary Image CDN (Free tier: 25 monthly credits)
CLOUDINARY_CLOUD_NAME=your_cloud_name_here
