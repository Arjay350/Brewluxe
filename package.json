{
  "name": "brewluxe",
  "version": "1.0.0",
  "author": "Brewluxe Team",
  "homepage": "https://ionicframework.com/",
  "scripts": {
    "ng": "node -r ./node-version-shim.cjs ./node_modules/@angular/cli/bin/ng.js",
    "start": "npm run ng -- serve",
    "build": "node ./scripts/set-env.cjs && npm run ng -- build",
    "android:sync": "npm run build && node ./scripts/generate-android-icons.cjs && npx cap sync android",
    "android:apk": "npm run android:sync && cd android && gradlew.bat assembleDebug",
    "android:open": "npx cap open android",
    "watch": "npm run ng -- build --watch --configuration development",
    "test": "npm run ng -- test",
    "lint": "npm run ng -- lint"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "22.0.1",
    "@angular/compiler": "22.0.1",
    "@angular/core": "22.0.1",
    "@angular/forms": "22.0.1",
    "@angular/platform-browser": "22.0.1",
    "@angular/router": "22.0.1",
    "@capacitor/android": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@ionic/angular": "^9.0.0",
    "@supabase/supabase-js": "^2.117.2",
    "ionicons": "^8.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "22.0.1",
    "@angular/cli": "22.0.1",
    "@angular/compiler-cli": "22.0.1",
    "@angular/language-service": "22.0.1",
    "@capacitor/cli": "^8.5.3",
    "@ionic/angular-toolkit": "^13.0.0",
    "angular-eslint": "22.0.0",
    "eslint": "^9.16.0",
    "jsdom": "^26.0.0",
    "sharp": "^0.35.4",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.61.0",
    "vitest": "^4.0.8"
  }
}
